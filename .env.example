# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for fanny
#
# USAGE:
#   cp .env.example .env
#   Fill in real values in .env
#   NEVER commit .env to git
#
# ADDING NEW VARIABLES:
#   1. Add the variable here with a description comment
#   2. Add it to the table in CLAUDE.md section 9
#   3. Add it to GitHub Actions secrets for CI/CD
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development               # development | test | production
PORT=3000                          # HTTP server port
LOG_LEVEL=info                     # debug | info | warn | error

# ── Database ──────────────────────────────────────────────────────────────────
# DATABASE_URL=                    # e.g. postgresql://user:pass@localhost:5432/dbname

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT_SECRET=                      # Min 32 chars, random. Generate: openssl rand -hex 32
# JWT_EXPIRY=15m                   # Access token expiry
# JWT_REFRESH_EXPIRY=7d            # Refresh token expiry

# ── External services ─────────────────────────────────────────────────────────
# Add third-party API keys here as needed
# STRIPE_SECRET_KEY=               # Stripe payments
# SENDGRID_API_KEY=                # Email delivery
# SENTRY_DSN=                      # Error tracking
